# Yardle local demo server — copy to `.env` / `.env.local` and fill in.
# Both files are gitignored. NEVER commit real secrets. Testnet only.

# --- XRPL (Testnet only; the server refuses any non-Testnet endpoint) -------
XRPL_TESTNET_ENDPOINT=wss://s.altnet.rippletest.net:51233
XRPL_TESTNET_BUYER_ADDRESS=
XRPL_TESTNET_BUYER_SECRET=
XRPL_TESTNET_SELLER_ADDRESS=

# --- Model provider (OpenAI-compatible; DeepSeek now, Agnes later) ---------
MODEL_PROVIDER=openai-compatible
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-chat
MODEL_API_KEY=

# --- Server -----------------------------------------------------------------
SERVER_HOST=127.0.0.1
SERVER_PORT=4782
